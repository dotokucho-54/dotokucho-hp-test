{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dotokucho-hp",
  "main": "worker.js",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "CMS"
    }
  ],
  "vars": {
    "CONTACT_EMAIL": "n-nakayama@sankyo-setsubi.jp"
  },
  "observability": {
    "enabled": true
  }
}
